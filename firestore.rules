rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Registration (existing behaviour) ──────────────────────────────
    // Public write during registration, public read for CBT activation check
    match /students/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // ── CBT User Profiles ─────────────────────────────────────────────
    // Only the authenticated user can read/write their own profile
    match /cbt_users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── CBT Exam Progress ─────────────────────────────────────────────
    match /cbt_progress/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── CBT Results ───────────────────────────────────────────────────
    // Write by the exam taker; read by anyone (admin dashboard is client-side)
    match /cbt_results/{uid} {
      allow write: if request.auth != null && request.auth.uid == uid;
      allow read: if true;
    }

    // ── Legacy waitlist ───────────────────────────────────────────────
    match /registrations/{docId} {
      allow read, write: if true;
    }
  }
}
